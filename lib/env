#!/usr/bin/env bash

# Environment configuration for ynkr
#
# All paths use environment variables with sensible defaults.
# For Docker: set YNKR_DB=/app/db/ynkr.db, YNKR_DOWNLOADS=/app/downloads, etc.
# For local dev: defaults resolve to ./db, ./downloads, ./music
#
# Environment variables:
#   YNKR_DB        - Path to SQLite database (default: ./db/ynkr.db)
#   YNKR_DOWNLOADS - Download staging directory (default: ./downloads)
#   YNKR_MUSIC     - Final music library directory (default: ./music)
#   YNKR_ARCHIVE   - yt-dlp archive file (default: ./.cache/archive.yt)
#   YNKR_PLAYLISTS - Playlist URLs file (default: ./playlists)
#   YNKR_DEBUG     - Enable debug logging (default: false)

declare DB="${YNKR_DB:-./db/ynkr.db}"
declare DOWNLOADS="${YNKR_DOWNLOADS:-./downloads}"
declare MUSIC_DIR="${YNKR_MUSIC:-./music}"
declare YNKR_DEBUG=${DEBUG:-false}
declare LAST_SCORE

declare ACOUSTID_KEY=${ACOUSTID_API_KEY:-}

declare -A YNKR_FAILED_DOWNLOADS

declare -A YNKR_PLAYLIST
YT_ARCHIVE="${YNKR_ARCHIVE:-/app/downloads/archive.yt}"
[[ -e "$YT_ARCHIVE" ]] || {
  mkdir -p "$(dirname "$YT_ARCHIVE")"
  touch "$YT_ARCHIVE"
}

SLEEP=3600
